# Copy to /opt/mahalla-service/config/production.env with mode 600.
# Replace every REPLACE value before validation. Secret values never belong here.
MCK_RELEASE=REPLACE_WITH_FULL_40_CHARACTER_GIT_SHA
NODE_IMAGE=node@sha256:REPLACE_WITH_64_CHARACTER_DIGEST
POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_64_CHARACTER_DIGEST

MCK_SECRET_DIR=/opt/mahalla-service/secrets
MCK_BACKUP_DIR=/var/backups/mahalla-service
MCK_BACKUP_DESTINATION=REPLACE_WITH_ENCRYPTED_OFF_HOST_DESTINATION
MCK_OPS_OWNER=mck-owner
MCK_HEALTH_PORT=3000
MCK_DB_NAME=mck
MCK_DB_USER=mck

LOG_LEVEL=info
AUTOMATION_POLL_SECONDS=30
RESIDENT_BOT_RATE_LIMIT=30
STAFF_BOT_RATE_LIMIT=60
TELEGRAM_RATE_LIMIT_WINDOW_SECONDS=60
