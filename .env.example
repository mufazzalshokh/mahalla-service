NODE_ENV=development
SERVICE_NAME=mahalla-service
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://mck:mck_local_only@127.0.0.1:5432/mck
AUTOMATION_ENABLED=false
AUTOMATION_POLL_SECONDS=30
RESIDENT_BOT_ENABLED=false
# Set only in local secret storage/environment; never commit a real token.
RESIDENT_BOT_TOKEN=
RESIDENT_BOT_RATE_LIMIT=30
STAFF_BOT_ENABLED=false
# Use a separate BotFather token for authorized staff; never commit a real token.
STAFF_BOT_TOKEN=
STAFF_BOT_RATE_LIMIT=60
TELEGRAM_RATE_LIMIT_WINDOW_SECONDS=60

# Local Docker dependency configuration only. Use secret management in production.
POSTGRES_PORT=5432
POSTGRES_DB=mck
POSTGRES_USER=mck
POSTGRES_PASSWORD=mck_local_only
